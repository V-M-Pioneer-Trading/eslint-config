{
  "name": "@v-m-pioneer-trading/eslint-config",
  "version": "1.0.0",
  "description": "Shared ESLint 10 flat config for V-M-Pioneer-Trading TypeScript repositories: typescript-eslint strictTypeChecked + stylisticTypeChecked, eslint-comments, and a React variant.",
  "license": "MIT",
  "author": "Max Radomskyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V-M-Pioneer-Trading/eslint-config.git"
  },
  "homepage": "https://github.com/V-M-Pioneer-Trading/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/V-M-Pioneer-Trading/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "typescript-eslint",
    "flat-config"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./react": "./react.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "react.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/config.test.js"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7"
  },
  "peerDependencies": {
    "eslint": "^10.12.0",
    "typescript": ">=5.7.0 <6.1.0",
    "typescript-eslint": "^8.71.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
